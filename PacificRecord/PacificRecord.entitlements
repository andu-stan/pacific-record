<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container for the widgets. Required for them to show anything. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ro.sofistic.pacificrecord</string>
	</array>

	<!-- iCloud Drive. Add these back alongside AppConfig.iCloudEnabled = true
	     and the NSUbiquitousContainers block in Info.plist:

	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.ro.sofistic.pacificrecord</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.ro.sofistic.pacificrecord</string>
	</array>
	-->
</dict>
</plist>
